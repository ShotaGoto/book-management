# ローカル開発 (docker-compose の PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/book_management?sslmode=disable

# 本番 (Supabase) の場合は以下のフォーマット:
# DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require

PORT=8080

# 本番で Cloudflare Pages のドメインを許可する場合:
# CORS_ALLOW_ORIGINS=https://your-project.pages.dev
